{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "react",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "legacy",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        ".claude/serve.cjs"
      ],
      "env": {
        "PORT": "8090",
        "ROOT": ".claude/worktrees/legacy-site"
      },
      "port": 8090
    },
    {
      "name": "prod",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npm run build && npm run preview -- --port 4173 --strictPort"
      ],
      "port": 4173
    }
  ]
}